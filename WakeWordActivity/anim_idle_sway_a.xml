<?xml version="1.0" encoding="utf-8"?>
<!-- Gentle infinite sway, for hair_strand_1 / cloak_1. Loop by setting
     repeatCount="infinite" repeatMode="reverse" on the AnimatorSet that
     loads this resource in code (see AtminiExpressionController.startIdle()). -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:propertyName="rotation"
    android:valueFrom="0"
    android:valueTo="3.5"
    android:duration="2200"
    android:interpolator="@android:interpolator/fast_out_slow_in"/>
